<!-- WiX 5 is the newest SDK that does not require accepting the Open Source
     Maintenance Fee EULA (introduced in WiX 6). To upgrade to WiX 6/7 later,
     bump the SDK version and follow https://wixtoolset.org/osmf/. -->
<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>MediaDownloaderSetup</OutputName>
    <Platforms>x64</Platforms>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputPath>..\..\out\</OutputPath>
    <SuppressSpecificWarnings>1147</SuppressSpecificWarnings>
    <AppProjectPath>$(MSBuildThisFileDirectory)..\..\MediaDownloader\MediaDownloader.csproj</AppProjectPath>
    <AppPublishDir>$(MSBuildThisFileDirectory)publish\$(Configuration)\</AppPublishDir>
    <!-- Global properties do not flow through Exec; forward the CalVer version
         passed by the release workflow into the inner publish explicitly. -->
    <AppPublishVersionArg Condition="'$(Version)' != ''">-p:Version=$(Version)</AppPublishVersionArg>
    <!-- MSI ProductVersion majors must be < 256, so the full CalVer year cannot
         be used there. The MSI gets a derived YY.M.D version (still increasing,
         still above the legacy 2.x installs); same-day rebuilds are covered by
         AllowSameVersionUpgrades in Product.wxs. -->
    <MsiVersion Condition="'$(MsiVersion)' == ''">$([System.DateTime]::UtcNow.ToString('yy.M.d'))</MsiVersion>
    <DefineConstants>$(DefineConstants);MsiVersion=$(MsiVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <BindPath Include="$(AppPublishDir)" BindName="publish" />
  </ItemGroup>

  <!-- Publish the self-contained application (including the bundled yt-dlp/ffmpeg,
       copied to output by the app project) before harvesting it into the MSI. -->
  <Target Name="PublishApplication" BeforeTargets="BeforeBuild">
    <Exec Command="dotnet publish &quot;$(AppProjectPath)&quot; -c $(Configuration) -r win-x64 --self-contained true -p:Platform=x64 -p:PublishReadyToRun=true $(AppPublishVersionArg) -o &quot;$(AppPublishDir.TrimEnd('\'))&quot;" />
  </Target>

</Project>
