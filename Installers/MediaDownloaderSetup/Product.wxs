<?xml version="1.0" encoding="UTF-8"?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?define ProductName = "Media Downloader"?>
  <?define Manufacturer = "Wolfcub"?>
  <!-- The UpgradeCode must never change: it is what lets new MSIs upgrade
       installations produced by the old WiX 3 installer. -->
  <?define UpgradeCode = "006c680b-7607-4170-9f90-53d7a69866ec"?>

  <!-- MSI product versions cap the major at 255, so the MSI uses a YY.M.D
       version derived from the public CalVer YYYY.MM.DD (see the wixproj). -->
  <Package Name="$(var.ProductName)"
           Language="1033"
           Version="$(var.MsiVersion)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed."
                  AllowSameVersionUpgrades="yes" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Scope="perUser" alone only affects install-scope validation; the actual
         runtime redirection of ProgramFiles64Folder to the per-user equivalent
         (%LOCALAPPDATA%\Programs) requires these two MSI properties. Without
         them the installer targets the real Program Files and needs elevation. -->
    <Property Id="ALLUSERS" Secure="yes" Value="2" />
    <Property Id="MSIINSTALLPERUSER" Secure="yes" Value="1" />

    <Property Id="ARPPRODUCTICON" Value="APPICON" />
    <Icon Id="APPICON" SourceFile="..\..\MediaDownloader\Images\icon.ico" />

    <Feature Id="ProductFeature" Title="[ProductName]" Level="1">
      <ComponentGroupRef Id="MediaDownloaderComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
      <!-- Harvest the publish output; the main exe has its own component above
           so its stable file id can anchor shortcuts and version binding. -->
      <Files Directory="INSTALLDIR" Include="!(bindpath.publish)\**">
        <Exclude Files="!(bindpath.publish)\MediaDownloader.exe" />
        <Exclude Files="!(bindpath.publish)\**\*.pdb" />
      </Files>
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="$(var.ProductName)" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="AppRootDirectory" Name="$(var.Manufacturer)">
        <Directory Id="INSTALLDIR" Name="$(var.ProductName)" />
      </Directory>
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="MediaDownloaderComponents">
      <Component Id="MediaDownloaderComponent" Directory="INSTALLDIR"
                 Guid="{66CF73EA-F47C-4617-88D9-3D03204DDD95}">
        <File Name="MediaDownloader.exe" Id="MediaDownloader.exe" KeyPath="yes"
              Source="!(bindpath.publish)\MediaDownloader.exe" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ShortcutComponents">
      <Component Id="DesktopShortcutComponent" Guid="*" Directory="DesktopFolder">
        <Shortcut Id="AppDesktopShortcut"
                  Name="$(var.ProductName)"
                  Directory="DesktopFolder"
                  Target="[#MediaDownloader.exe]"
                  WorkingDirectory="INSTALLDIR"
                  Icon="APPICON" />
        <!-- Remove desktop shortcut on uninstall -->
        <RemoveFolder Id="DesktopFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\$(var.Manufacturer)\$(var.ProductName)" Name="installed"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="ApplicationShortcut" Guid="*" Directory="ApplicationProgramsFolder">
        <Shortcut Id="ApplicationStartMenuShortcut" Name="$(var.ProductName)"
                  Icon="APPICON" Target="[#MediaDownloader.exe]" WorkingDirectory="INSTALLDIR" />
        <!-- Remove application shortcut from Program Menu on uninstall -->
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
        <!-- Create application registry entry -->
        <RegistryValue Root="HKCU" Key="Software\Microsoft\$(var.Manufacturer)\$(var.ProductName)"
                       Name="installed"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
